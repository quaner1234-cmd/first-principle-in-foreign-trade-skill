{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "Trade Judgment Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "status",
    "phase",
    "provider",
    "policy_version",
    "input_text",
    "input_metadata",
    "input_hash",
    "routing",
    "turns",
    "tool_results",
    "pending_tool_calls",
    "approvals",
    "decision",
    "validation_errors",
    "error",
    "turn_count",
    "max_turns",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "status": {
      "type": "string",
      "enum": [
        "created",
        "running",
        "waiting_tool_result",
        "waiting_approval",
        "completed",
        "failed_recoverable",
        "failed"
      ]
    },
    "phase": {"type": "string", "enum": ["intake", "routing", "decision", "tools", "validation", "complete", "failed"]},
    "provider": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "input_text": {"type": "string"},
    "input_metadata": {"type": "object"},
    "input_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "routing": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "turns": {"type": "array", "items": {"type": "object"}},
    "tool_results": {"type": "object"},
    "pending_tool_calls": {"type": "array", "items": {"type": "object"}},
    "approvals": {"type": "object"},
    "decision": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "error": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "turn_count": {"type": "integer", "minimum": 0},
    "max_turns": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
